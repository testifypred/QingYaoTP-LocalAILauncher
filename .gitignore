# 本地 AI 工作台 —— 仓库只装源码与文档，运行期产物一律不进

# 模型权重：GB 级，绝不上库
*.gguf
*.part
.downloads/

# 发布包：由 server/build-portable.ps1 一键重建，不入库（体积 250MB+）
dist/

# 依赖
node_modules/

# 语音：piper 二进制与音色、合成缓存（运行期下载/生成，约 100MB）
tts/
asr/deps/

# 工作区：全部是用户数据（会话、历史快照、RAG 索引、备份与引导状态）
workspace/

# 运行日志与进程号
*.log
*.log.err
server/server.pid

# 探针留档：截图、音频、被 wipe 前的会话备份（体积大，跑探针可再生）
server/docs/*.png
server/docs/**/*.png
server/docs/*.wav
server/docs/*.mp3
server/docs/session-backups/
server/docs/probe-full-*/logs/
server/docs/probe-full-*/shots/
server/docs/probe-full-*/rerun/
server/docs/probe-full-*/server-restart-*
# 驱动自己写的 summary.txt 是混合编码（表头 utf8 + 逐条 utf16），只作运行留档，正式汇总看 RESULT.md
server/docs/probe-full-*/summary.txt

# 视觉 sidecar：本地下载的 llama.cpp 二进制与测试图（随发布包分发，不入库）
tools/
mmproj/
logs/

# DSH 桌面端插件（与项目无关）
dsh-cost-meter/

# 解压第三方包时的临时目录
tmp-*/

# 图标：源稿（*.svg）与成品（localai.ico / debug-icon-64.png）入库，渲染中间产物不入库
server/icon-parts/
server/icon-512.png
server/icon-app-512.png
server/icon-app-small-512.png
server/icon-debug-512.png
server/icon-*.html
server/icon-parts-debug/
server/icon-debug-small-512.png
server/icon-debug-mid-512.png
server/icon-preview*.png
server/debug-icon-16.png
server/debug-icon-32.png
server/debug-icon-256.png

# Python 编译产物（make-model-icons.py 的 py_compile）
__pycache__/
*.pyc

# 运行期配置（v1.8.0 云端复审）：data\cloud-review.json 里可能有 API Key，绝不入库
# 发布包里的 data\ 由 make-zip.ps1 整目录排除，并由它断言不出现 data/cloud-review*
data/
