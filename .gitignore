# 本地 AI 工作台 —— 仓库只装源码与文档，运行期产物一律不进

# 模型权重：GB 级，绝不上库
*.gguf
*.part
.downloads/

# 发布包：由 server/build-portable.ps1 一键重建，不入库（体积 250MB+）
dist/

# 依赖
node_modules/

# 语音：piper 二进制与音色、合成缓存（运行期下载/生成，约 100MB）
tts/
asr/deps/

# 工作区：全部是用户数据（会话、历史快照、RAG 索引、备份与引导状态）
workspace/

# 运行日志与进程号
*.log
*.log.err
server/server.pid

# 探针留档：截图、音频、被 wipe 前的会话备份（体积大，跑探针可再生）
server/docs/*.png
server/docs/**/*.png
server/docs/*.wav
server/docs/*.mp3
server/docs/session-backups/
server/docs/probe-full-*/logs/
server/docs/probe-full-*/shots/
server/docs/probe-full-*/rerun/
server/docs/probe-full-*/server-restart-*
# 驱动自己写的 summary.txt 是混合编码（表头 utf8 + 逐条 utf16），只作运行留档，正式汇总看 RESULT.md
server/docs/probe-full-*/summary.txt

# 解压第三方包时的临时目录
tmp-*/

# 图标渲染的中间产物（icon.svg 源文件与 localai.ico 成品要入库）
server/icon-parts/
server/icon-512.png
server/icon-lab.png
server/icon-lab.html
server/icon-a.svg
server/icon-b.svg
server/icon-b2.svg
server/icon-c.svg
server/icon-c2.svg
server/icon-preview*.png
